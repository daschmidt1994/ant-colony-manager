# ─────────────────────────────────────────────────────────────────────────────
# Ant Colony Manager – Konfiguration (Heimnetz / Einstieg)
#
#   cp .env.example .env     → mindestens PUBLIC_APP_URL anpassen
#   docker compose up -d
#
# Secrets (Datenbank-Passwort, JWT, Instanz-Secret) werden beim ersten Start
# automatisch erzeugt und in data/secrets/ gespeichert. Du kannst sie hier
# auch selbst setzen – Werte in dieser Datei haben Vorrang.
# Für den Betrieb im Internet: .env.production.example verwenden.
# ─────────────────────────────────────────────────────────────────────────────

# Adresse, unter der Handys und Browser den Server erreichen.
# Daraus entstehen die QR-/NFC-Links: <PUBLIC_APP_URL>/c/<code>
# Beispiele: http://192.168.1.50:8080 · https://ants.home.arpa · https://ants.example.com
# Tipp: ./scripts/init-env.sh trägt die IP dieses Rechners automatisch ein.
PUBLIC_APP_URL=http://192.168.1.50:8080

# Frühere Adressen, deren QR/NFC-Codes weiter erkannt werden (Komma-getrennt)
LEGACY_APP_URLS=

INSTANCE_NAME=Ant Colony Manager
TZ=Europe/Vienna

# Port der Web-App/API auf diesem Rechner. APP_BIND=127.0.0.1 → nur lokal (hinter Proxy)
APP_PORT=8080
APP_BIND=0.0.0.0

# ── Speicherort aller Daten (Datenbank, Fotos, Backups, Secrets) ─────────────
DATA_DIR=./data
# Benutzer/Gruppe, denen die Dateien gehören (Synology meist 1026/100, QNAP 1000/100)
PUID=1000
PGID=1000

# ── Datenbank ────────────────────────────────────────────────────────────────
POSTGRES_DB=acm
POSTGRES_USER=acm
# leer = automatisch erzeugt (data/secrets/postgres_password)
POSTGRES_PASSWORD=

# ── Secrets (leer = automatisch erzeugt; mindestens 32 zufällige Zeichen) ────
JWT_SECRET=
INSTANCE_SECRET=

# ── Konten ───────────────────────────────────────────────────────────────────
# open = jeder kann sich registrieren · invite = nur mit Einladung · closed = niemand
REGISTRATION_MODE=invite
SESSION_REFRESH_DAYS=90

# ── Fotos ────────────────────────────────────────────────────────────────────
UPLOAD_MAX_MB=20
PHOTO_KEEP_ORIGINAL=false

# ── E-Mail (optional; ohne SMTP: Passwort-Reset-Link über Admin oder
#    docker compose exec app /acm user reset-link <mail>) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls | tls | none
SMTP_TLS=starttls

# ── Backups ──────────────────────────────────────────────────────────────────
# Cron-Ausdruck (Standard: täglich 03:00)
BACKUP_SCHEDULE=0 3 * * *
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# true = .env unverändert (mit Secrets!) ins Backup kopieren
BACKUP_INCLUDE_ENV=false

# ── Optionaler HTTPS-Proxy (Caddy) ───────────────────────────────────────────
# COMPOSE_PROFILES=proxy aktiviert ihn. Dann PUBLIC_APP_URL=https://<ACM_DOMAIN>.
COMPOSE_PROFILES=
ACM_DOMAIN=
# acme = Let's Encrypt (öffentliche Domain) · internal = eigene CA (nur Heimnetz)
ACM_TLS_MODE=acme
HTTP_PORT=80
HTTPS_PORT=443
# Absender-Adressen, denen X-Forwarded-For geglaubt wird (Proxy). Leer ohne Proxy.
TRUSTED_PROXIES=

# ── Android App Links (nur für selbst gebaute APK, siehe docs/06) ────────────
ANDROID_APP_ID=at.antcolony.manager
ANDROID_CERT_SHA256=

# ── Betrieb ──────────────────────────────────────────────────────────────────
# Image-Version (latest oder z. B. 1.0.0)
ACM_VERSION=latest
LOG_LEVEL=info
# json | text
LOG_FORMAT=text
# Netz des Stacks (nur ändern, falls es mit einem vorhandenen Netz kollidiert)
ACM_SUBNET=172.30.47.0/24
