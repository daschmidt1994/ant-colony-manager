# ─────────────────────────────────────────────────────────────────────────────
# Ant Colony Manager – Produktion im Internet (HTTPS über Caddy)
#
#   cp .env.production.example .env
#   → ACM_DOMAIN und PUBLIC_APP_URL setzen, DNS auf diesen Server zeigen lassen,
#     Ports 80 und 443 freigeben
#   docker compose up -d
# ─────────────────────────────────────────────────────────────────────────────
PUBLIC_APP_URL=https://ants.example.com
ACM_DOMAIN=ants.example.com
ACM_TLS_MODE=acme
COMPOSE_PROFILES=proxy
LEGACY_APP_URLS=

INSTANCE_NAME=Ant Colony Manager
TZ=Europe/Vienna

# App nur lokal erreichbar – von außen ausschließlich über Caddy (HTTPS)
APP_BIND=127.0.0.1
APP_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443
# Caddy läuft im Stack-Netz
TRUSTED_PROXIES=172.30.47.0/24
ACM_SUBNET=172.30.47.0/24

DATA_DIR=./data
PUID=1000
PGID=1000

POSTGRES_DB=acm
POSTGRES_USER=acm
# leer = automatisch erzeugt (empfohlen)
POSTGRES_PASSWORD=
JWT_SECRET=
INSTANCE_SECRET=

REGISTRATION_MODE=invite
SESSION_REFRESH_DAYS=90

UPLOAD_MAX_MB=20
PHOTO_KEEP_ORIGINAL=false

# Für Passwort-Reset per E-Mail empfohlen
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls

BACKUP_SCHEDULE=0 3 * * *
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_INCLUDE_ENV=false

ANDROID_APP_ID=at.antcolony.manager
ANDROID_CERT_SHA256=

# Für reproduzierbare Updates eine feste Version eintragen, z. B. 1.0.0
ACM_VERSION=latest
LOG_LEVEL=info
LOG_FORMAT=json
