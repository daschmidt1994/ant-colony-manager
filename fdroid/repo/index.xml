36</targetSdkVersion><added>2026-10-01</added><sig>594ae32baceee744af363131e489cfe7</sig><permissions>ACCESS_NETWORK_STATE,CAMERA,FOREGROUND_SERVICE,FOREGROUND_SERVICE_SHORT_SERVICE,INTERNET,NFC,POST_NOTIFICATIONS,RECEIVE_BOOT_COMPLETED,VIBRATE,WAKE_LOCK,at.antcolony.manager.dev.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION</permissions><nativecode>armeabi-v7a</nativecode></package></application><application id="at.antcolony.manager"><id>at.antcolony.manager</id><added>2026-10-01</added><lastupdated>2026-10-02</lastupdated><name>Ant Colony Manager</name><summary>Ameisenkolonien pflegen – NFC/QR scannen, dokumentieren, erinnern</summary><desc>Selbst gehostete Verwaltung von Ameisenkolonien: Handy an den NFC-Tag halten
oder QR-Code scannen, sehen was ansteht, Fütterung, Wasser oder Reinigung mit
einem Tap dokumentieren.

* Offline-fähig, synchronisiert mit deinem eigenen Server
* Fälligkeiten mit Ampel, Erinnerungen, Pflege-Rundgang
* Winterruhe planen, erinnern lassen und per Schalter starten/beenden
* Fotos, Messwerte, Statistiken, Etiketten, PDF-Berichte

Benötigt einen eigenen Ant-Colony-Manager-Server (Docker).</desc><license>AGPL-3.0-only</license><categories>Science &amp; Education</categories><category>Science &amp; Education</category><web></web><source>https://github.com/daschmidt1994/ant-colony-manager</source><tracker>https://github.com/daschmidt1994/ant-colony-manager/issues</tracker><changelog>https://github.com/daschmidt1994/ant-colony-manager/releases</changelog><author>daschmidt1994</author><marketversion></marketversion><marketvercode>4229</marketvercode><package><version>1.4.6</version><versioncode>4229</versioncode><apkname>at.antcolony.manager_229_x86_64.apk</apkname><hash type="sha256">bd01256ec1ff4901f2c4b0db7fc9df97a05b479657b97108cfb58a0c82fe518c</hash><size>38397272</size><sdkver>24</sdkver><targetSdkVersion>36</targetSdkVersion><added>2026-10-02</added><sig>594ae32baceee744af363131e489cfe7</sig><permissions>ACCESS_NETWORK_STATE,CAMERA,FOREGROUND_SERVICE,FOREGROUND_SERVICE_SHORT_SERVICE,INTERNET,NFC,POST_NOTIFICATIONS,RECEIVE_BOOT_COMPLETED,VIBRATE,WAKE_LOCK,at.antcolony.manager.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION</permissions><nativecode>x86_64</nativecode></package><package><version>1.4.5</version><versioncode>4227</versioncode><apkname>at.antcolony.manager_227_x86_64.apk</apkname><hash type="sha256">888eda7fa1df010cfd4bc4d41ec8ed573316bc0fe44474bf0bbdefcbcd2b46e9</hash><size>38397272</size><sdkver>24</sdkver><targetSdkVersion>36</targetSdkVersion><added>2026-10-01</added><sig>594ae32baceee744af363131e489cfe7</sig><permissions>ACCESS_NETWORK_STATE,CAMERA,FOREGROUND_SERVICE,FOREGROUND_SERVICE_SHORT_SERVICE,INTERNET,NFC,POST_NOTIFICATIONS,RECEIVE_BOOT_COMPLETED,VIBRATE,WAKE_LOCK,at.antcolony.manager.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION</permissions><nativecode>x86_64</nativecode></package><package><version>1.4.4</version><versioncode>4219</versioncode><apkname>at.antcolony.manager_219_x86_64.apk</apkname><hash type="sha256">dc4ddc9e3ad8ae6403dee62a8a846b44b044c19c379d74461f5cd028d6019d