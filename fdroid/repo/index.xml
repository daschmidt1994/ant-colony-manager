36</targetSdkVersion><added>2026-10-01</added><sig>594ae32baceee744af363131e489cfe7</sig><permissions>ACCESS_NETWORK_STATE,CAMERA,FOREGROUND_SERVICE,FOREGROUND_SERVICE_SHORT_SERVICE,INTERNET,NFC,POST_NOTIFICATIONS,RECEIVE_BOOT_COMPLETED,VIBRATE,WAKE_LOCK,at.antcolony.manager.dev.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION</permissions><nativecode>armeabi-v7a</nativecode></package></application><application id="at.antcolony.manager"><id>at.antcolony.manager</id><added>2026-10-01</added><lastupdated>2026-10-01</lastupdated><name>Ant Colony Manager</name><summary>Ameisenkolonien pflegen – NFC/QR scannen, dokumentieren, erinnern</summary><desc>Selbst gehostete Verwaltung von Ameisenkolonien: Handy an den NFC-Tag halten
oder QR-Code scannen, sehen was ansteht, Fütterung, Wasser oder Reinigung mit
einem Tap dokumentieren.

* Offline-fähig, synchronisiert mit deinem eigenen Server
* Fälligkeiten mit Ampel, Erinnerungen, Pflege-Rundgang
* Winterruhe planen, erinnern lassen und per Schalter starten/beenden
* Fotos, Messwerte, Statistiken, Etiketten, PDF-Berichte

Benötigt einen eigenen Ant-Colony-Manager-Server (Docker).</desc><license>AGPL-3.0-only</license><categories>Science &amp; Education</categories><category>Science &amp; Education</category><web></web><source>https://github.com/daschmidt1994/ant-colony-manager</source><tracker>https://github.com/daschmidt1994/ant-colony-manager/issues</tracker><changelog>https://github.com/daschmidt1994/ant-colony-manager/releases</changelog><author>daschmidt1994</author><marketversion></marketversion><marketvercode>4198</marketvercode><package><version>1.4.2</version><versioncode>4198</versioncode><apkname>at.antcolony.manager_198_x86_64.apk</apkname><hash type="sha256">a6b8f3e966853fe3a10655a1e26321df4d9b57796da664e22feb034a2765b81b</hash><size>38265476</size><sdkver>24</sdkver><targetSdkVersion>36</targetSdkVersion><added>2026-10-01</added><sig>594ae32baceee744af363131e489cfe7</sig><permissions>ACCESS_NETWORK_STATE,CAMERA,FOREGROUND_SERVICE,FOREGROUND_SERVICE_SHORT_SERVICE,INTERNET,NFC,POST_NOTIFICATIONS,RECEIVE_BOOT_COMPLETED,VIBRATE,WAKE_LOCK,at.antcolony.manager.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION</permissions><nativecode>x86_64</nativecode></package><package><version>1.4.1</version><versioncode>4188</versioncode><apkname>at.antcolony.manager_188_x86_64.apk</apkname><hash type="sha256">ff8f1fd9006cc5e604de5b57b382f1562bcdb0f355b60e56907f8ad737cc28e3</hash><size>38265472</size><sdkver>24</sdkver><targetSdkVersion>36</targetSdkVersion><added>2026-10-01</added><sig>594ae32baceee744af363131e489cfe7</sig><permissions>ACCESS_NETWORK_STATE,CAMERA,FOREGROUND_SERVICE,FOREGROUND_SERVICE_SHORT_SERVICE,INTERNET,NFC,POST_NOTIFICATIONS,RECEIVE_BOOT_COMPLETED,VIBRATE,WAKE_LOCK,at.antcolony.manager.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION</permissions><nativecode>x86_64</nativecode></package><package><version>1.4.0</version><versioncode>4176</versioncode><apkname>at.antcolony.manager_176_x86_64.apk</apkname><hash type="sha256">81f2855713d5832f229e69b06f0f4c4808d89c956223ed23ea5b98fd5fcc70