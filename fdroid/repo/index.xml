tSdkVersion><added>2026-09-28</added><sig>594ae32baceee744af363131e489cfe7</sig><permissions>ACCESS_NETWORK_STATE,CAMERA,FOREGROUND_SERVICE,FOREGROUND_SERVICE_SHORT_SERVICE,INTERNET,NFC,POST_NOTIFICATIONS,RECEIVE_BOOT_COMPLETED,VIBRATE,WAKE_LOCK,at.antcolony.manager.dev.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION</permissions><nativecode>armeabi-v7a</nativecode></package></application><application id="at.antcolony.manager"><id>at.antcolony.manager</id><added>2026-09-27</added><lastupdated>2026-09-28</lastupdated><name>Ant Colony Manager</name><summary>Ameisenkolonien pflegen – NFC/QR scannen, dokumentieren, erinnern</summary><desc>Selbst gehostete Verwaltung von Ameisenkolonien: Handy an den NFC-Tag halten
oder QR-Code scannen, sehen was ansteht, Fütterung, Wasser oder Reinigung mit
einem Tap dokumentieren.

* Offline-fähig, synchronisiert mit deinem eigenen Server
* Fälligkeiten mit Ampel, Erinnerungen, Pflege-Rundgang
* Winterruhe planen, erinnern lassen und per Schalter starten/beenden
* Fotos, Messwerte, Statistiken, Etiketten, PDF-Berichte

Benötigt einen eigenen Ant-Colony-Manager-Server (Docker).</desc><license>AGPL-3.0-only</license><categories>Science &amp; Education</categories><category>Science &amp; Education</category><web></web><source>https://github.com/daschmidt1994/ant-colony-manager</source><tracker>https://github.com/daschmidt1994/ant-colony-manager/issues</tracker><changelog>https://github.com/daschmidt1994/ant-colony-manager/releases</changelog><author>daschmidt1994</author><marketversion></marketversion><marketvercode>4080</marketvercode><package><version>1.2.1</version><versioncode>4080</versioncode><apkname>at.antcolony.manager_80_x86_64.apk</apkname><hash type="sha256">3d77436867593561fdbf289455be016d2dc00f184301c2b338dea5cee3ddb5a9</hash><size>36610776</size><sdkver>24</sdkver><targetSdkVersion>36</targetSdkVersion><added>2026-09-28</added><sig>594ae32baceee744af363131e489cfe7</sig><permissions>ACCESS_NETWORK_STATE,CAMERA,FOREGROUND_SERVICE,FOREGROUND_SERVICE_SHORT_SERVICE,INTERNET,NFC,POST_NOTIFICATIONS,RECEIVE_BOOT_COMPLETED,VIBRATE,WAKE_LOCK,at.antcolony.manager.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION</permissions><nativecode>x86_64</nativecode></package><package><version>1.2.0</version><versioncode>4072</versioncode><apkname>at.antcolony.manager_72_x86_64.apk</apkname><hash type="sha256">4fcbcf31b91ed09948ac1ffd829828741717378de3b864f59e9390c7c5848362</hash><size>36610568</size><sdkver>24</sdkver><targetSdkVersion>36</targetSdkVersion><added>2026-09-28</added><sig>594ae32baceee744af363131e489cfe7</sig><permissions>ACCESS_NETWORK_STATE,CAMERA,FOREGROUND_SERVICE,FOREGROUND_SERVICE_SHORT_SERVICE,INTERNET,NFC,POST_NOTIFICATIONS,RECEIVE_BOOT_COMPLETED,VIBRATE,WAKE_LOCK,at.antcolony.manager.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION</permissions><nativecode>x86_64</nativecode></package><package><version>1.1.0</version><versioncode>4048</versioncode><apkname>at.antcolony.manager_48_x86_64.apk</apkname><hash type="sha256">89be9413afdf9dc7862f19e42a95026eec7a0490a18986f2ba25933008f99d32<