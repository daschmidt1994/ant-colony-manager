{"repo": {"timestamp": 1790665817000, "version": 20002, "name": "Ant Colony Manager", "icon": "icon.png", "address": "https://daschmidt1994.github.io/ant-colony-manager/fdroid/repo", "description": "Selbst gehostete Verwaltung von Ameisenkolonien. Updates der Android-App direkt aus GitHub \u2013 https://github.com/daschmidt1994/ant-colony-manager"}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorName": "daschmidt1994", "categories": ["Science & Education"], "suggestedVersionCode": "4097", "description": "Testversion des Ant Colony Managers \u2013 gebaut aus jedem Stand von main,\nnoch nicht als Version ver\u00f6ffentlicht. L\u00e4uft neben der normalen App\n(eigene App-ID) und ist f\u00fcr einen eigenen Test-Server gedacht.\n\nNicht f\u00fcr die t\u00e4gliche Pflege: kann Fehler enthalten. Die normale App\nhei\u00dft \u201eAnt Colony Manager\u201c.", "issueTracker": "https://github.com/daschmidt1994/ant-colony-manager/issues", "license": "AGPL-3.0-only", "name": "ACM Test", "sourceCode": "https://github.com/daschmidt1994/ant-colony-manager", "summary": "Testversion des Ant Colony Managers (aktueller Stand von main)", "added": 1790659119000, "packageName": "at.antcolony.manager.dev", "lastUpdated": 1790665810000}, {"authorName": "daschmidt1994", "categories": ["Science & Education"], "changelog": "https://github.com/daschmidt1994/ant-colony-manager/releases", "suggestedVersionCode": "4087", "description": "Selbst gehostete Verwaltung von Ameisenkolonien: Handy an den NFC-Tag halten\noder QR-Code scannen, sehen was ansteht, F\u00fctterung, Wasser oder Reinigung mit\neinem Tap dokumentieren.\n\n* Offline-f\u00e4hig, synchronisiert mit deinem eigenen Server\n* F\u00e4lligkeiten mit Ampel, Erinnerungen, Pflege-Rundgang\n* Winterruhe planen, erinnern lassen und per Schalter starten/beenden\n* Fotos, Messwerte, Statistiken, Etiketten, PDF-Berichte\n\nBen\u00f6tigt einen eigenen Ant-Colony-Manager-Server (Docker).", "issueTracker": "https://github.com/daschmidt1994/ant-colony-manager/issues", "license": "AGPL-3.0-only", "name": "Ant Colony Manager", "sourceCode": "https://github.com/daschmidt1994/ant-colony-manager", "summary": "Ameisenkolonien pflegen \u2013 NFC/QR scannen, dokumentieren, erinnern", "added": 1790627920000, "packageName": "at.antcolony.manager", "lastUpdated": 1790658397000}], "packages": {"at.antcolony.manager": [{"added": 1790658397000, "apkName": "at.antcolony.manager_87_x86_64.apk", "hash": "6b1069f6ca1d2cef1fd5ddfec02d5c19687256d981ec84a92d00aae51d10a54a", "hashType": "sha256", "minSdkVersion": 24, "nativecode": ["x86_64"], "packageName": "at.antcolony.manager", "sig": "594ae32baceee744af363131e489cfe7", "signer": "ab8147a3daffd62e82f1d31f1fe11ae6dcfe87081de578709b4f1be21bc745fd", "size": 36676312, "targetSdkVersion": 36, "uses-permission": [["android.permission.INTERNET", null], ["android.permission.NFC", null], ["android.permission.CAMERA", null], ["android.permission.POST_NOTIFICATIONS", null], ["android.permission.RECEIVE_BOOT_COMPLETED", null], ["android.permission.ACCESS_NETWORK_STATE", null], ["android.permission.VIBRATE", null], ["android.permission.FOREGROUND_SERVICE", null], ["android.permission.FOREGROUND_SERVICE_SHORT_SERVICE", null], ["android.permission.WAKE_LOCK", null], ["at.antcolony.manager.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION", null]], "versionCode": 4087, "versionName": "1.2.2"}, {"added": 1790634446000, "apkName": "at.antcolony.manager_80_x86_64.apk", "hash": "3d77436867593561fdbf289455be016d2dc00f184301c2b338dea5cee3ddb5a9", "hashType": "sha256", "minSdkVersion": 24, "nativecode": ["x86_64"], "packageName": "at.antcolony.manager", "sig": "594ae32baceee744af363131e489cfe7", "signer": "ab8147a3daffd62e82f1d31f1fe11ae6dcfe87081de578709b4f1be21bc745fd", "size": 36610776, "targetSdkVersion": 36, "uses-permission": [["android.permission.INTERNET", null], ["android.permission.NFC", null], ["android.permission.CAMERA", null], ["android.permission.POST_NOTIFICATIONS", null], ["and